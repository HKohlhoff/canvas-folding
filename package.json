{
  "name": "canvas-folding",
  "version": "1.2.2",
  "description": "Collapse and expand hierarchical branches in Canvas.",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "create:test-vault": "node scripts/create-test-vault.mjs",
    "lint": "eslint . --max-warnings=0",
    "build": "node build.mjs --production",
    "build:deploy": "node build.mjs --deploy",
    "test": "npm run lint && npm run typecheck && npm run test:metadata && npm run test:unit",
    "test:metadata": "node scripts/check-release-metadata.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.mjs --watch",
    "dev:deploy": "node build.mjs --watch --deploy",
    "build:prod": "node build.mjs --production",
    "build:prod:deploy": "node build.mjs --production --deploy",
    "dev:prod": "node build.mjs --watch --production",
    "dev:prod:deploy": "node build.mjs --watch --production --deploy",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "canvas",
    "folding",
    "graph"
  ],
  "author": "Holger Kohlhoff",
  "license": "GPL-3.0-or-later",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.11.0",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HKohlhoff/canvas-folding.git"
  },
  "bugs": {
    "url": "https://github.com/HKohlhoff/canvas-folding/issues"
  },
  "homepage": "https://github.com/HKohlhoff/canvas-folding#readme"
}
